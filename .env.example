# Lattice Designer frontend settings (copy to .env)

# Backend API URL. The backend default port is 8000 (scripts/dev.ps1 -Port changes it).
VITE_API_URL=http://localhost:8000

# REAL backend by default. "true" replays stored real backend output with no server (npm run dev:mock).
VITE_USE_MOCK=false

# Show the implant tab. The implant backend does not exist yet: it only works against the mock.
VITE_ENABLE_IMPLANT=false
